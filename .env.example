USERNAME=username
EMAIL_ADDRESS=username@gmail.com
PASSWORD=password

# Comma-separated PATs; grant read:user and public_repo (not repo).
GH_TOKENS=

# Or use one variable per account:
# GH_TOKEN_PERSONAL=
# GH_TOKEN_WORK=
# Optional single-account compatibility fallback:
# GH_PAT=

PORTFOLIO_DB_PATH=./backend/db/portfolio.db
