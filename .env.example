USERNAME=username
EMAIL_ADDRESS=username@gmail.com
PASSWORD=password

GITHUB_TOKENS=github_pat_1XXXX,github_pat_2XXXX

# Optional
# GITHUB_INCLUDE_FORKS=boolean
# Private repos are shown as "Private repository" (no name/description/link) by default,
# because the data is baked into your published page. Set to false for local/personal use.
# GITHUB_REDACT_PRIVATE=boolean


# Any variable whose name starts with GITHUB_TOKEN is treated as one account.
# Classic PAT needs `repo` (for private repos) or a fine-grained token with Contents + Metadata read.
GITHUB_TOKEN_PERSONAL=ghp_xxx
GITHUB_TOKEN_WORK=ghp_xxx

PORTFOLIO_DB_PATH=./path-to-db/portfolio.db
# The lock icon next to your name links here (Django admin).
PUBLIC_DJANGO_ADMIN_URL=http://host:port/admin/
