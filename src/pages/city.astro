---
import ContributionCity from '@/components/contribution-city/ContributionCity';
import { loadCityRepos } from '@/lib/github-repos';

// All of this runs on the server (build time, or per request in SSR). Tokens never reach the browser.
const { repos, tokenMissing, errors } = await loadCityRepos();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Contribution City</title>
    <style>
      body { margin: 0; padding: 24px; background: #061a19; }
      .note { color: #99f6e4; font: 13px system-ui; margin: 0 0 12px; }
    </style>
  </head>
  <body>
    {tokenMissing && <p class="note">Repository data is empty until GITHUB_TOKENS is configured.</p>}
    {errors.map((error) => <p class="note">{error}</p>)}
    <!-- client:only: the 3D canvas needs a browser, so skip SSR for it -->
    <ContributionCity client:only="react" repos={repos} height="85vh" />
  </body>
</html>