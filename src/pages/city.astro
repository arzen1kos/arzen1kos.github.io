---
// Example page: src/pages/city.astro
// Requires @astrojs/react in astro.config.mjs.
import ContributionCity from '@components/city/ContributionCity';
// import ContributionCity from '@components/ContributionCity/ContributionCity';
import { loadCityRepos } from '../lib/github-repos';

// Runs at build time (or per request in SSR). Tokens stay on the server.
const { repos, demo } = await loadCityRepos();

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Contribution City</title>
    <style>
      body { margin: 0; padding: 24px; background: #061a19; }
      .note { color: #99f6e4; font: 13px system-ui; margin: 0 0 12px; }
    </style>
  </head>
  <body>
    {demo && <p class="note">Showing sample data. Set GITHUB_TOKENS in .env to load your repositories.</p>}
    <ContributionCity client:only="react" repos={repos} height="80vh" />
  </body>
</html>