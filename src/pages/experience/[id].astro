---
import Base from '@/layouts/Base.astro';
import { getExperience } from '@/lib/portfolio';
import { formatMonth } from '@/lib/format';
// export const prerender = false;

const id = Number(Astro.params.id);
const item = Number.isInteger(id) ? getExperience(id) : null;
if (!item) return new Response('Not found', { status: 404 });
const bullets = item.details.length ? item.details : [item.summary];
---
<Base title={`${item.title} · ${item.organisation}`}>
  <main>
    <a class="back" href="/">Back to the city</a>
    <p class="when">{formatMonth(item.startDate)} – {item.endDate ? formatMonth(item.endDate) : 'Present'}</p>
    <h1>{item.title}</h1>
    <p class="org">{item.organisation}{item.location && `, ${item.location}`}</p>
    <p class="summary">{item.summary}</p>
    <ul>{bullets.map((b) => <li>{b}</li>)}</ul>
  </main>
</Base>

<style>
  main { max-width: 46rem; margin: 0 auto; padding: 4rem 1.5rem 6rem; font-family: 'Schibsted Grotesk', system-ui, sans-serif; color: #1d1d1b; min-height: 100vh; background: #f2f2f0; }
  :global(body) { background: #f2f2f0; }
  .back { display: inline-block; margin-bottom: 3rem; color: #1d1d1b; font-weight: 600; }
  .when { color: #666; margin: 0 0 .5rem; }
  h1 { font-size: clamp(2rem, 6vw, 3.2rem); line-height: 1.05; letter-spacing: -.03em; font-weight: 800; margin: 0 0 .5rem; }
  .org { font-size: 1.2rem; font-weight: 600; margin: 0 0 1.5rem; }
  .summary { font-size: 1.15rem; line-height: 1.6; color: #333; }
  ul { padding-left: 1.2rem; line-height: 1.7; font-size: 1.05rem; }
</style>
