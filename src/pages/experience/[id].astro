---
import Base from '../../layouts/Base.astro';
import { experience } from '../../data/experience';
import { site } from '../../data/site';

export function getStaticPaths() {
  return experience.map((job, index) => ({
    params: { id: job.id },
    props: { job, previous: experience[index - 1], next: experience[index + 1] },
  }));
}

const { job, previous, next } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title={`${job.role} | ${site.name}`} description={job.summary}>
  <main class="full">
    <a class="full-back" href={`${base}/?open=experience`}>Back to the node tree</a>

    <article>
      <p class="full-period">{job.period}</p>
      <h1>{job.role}</h1>
      <p class="full-org">{job.org}</p>
      <p class="full-summary">{job.summary}</p>

      <ul class="full-details">
        {job.details.map((line) => <li>{line}</li>)}
      </ul>

      <ul class="full-tags" aria-label="Tags">
        {job.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </article>

    <nav class="full-nav" aria-label="Other experience">
      {previous ? <a href={`${base}/experience/${previous.id}/`}>Newer: {previous.role}</a> : <span />}
      {next ? <a href={`${base}/experience/${next.id}/`}>Older: {next.role}</a> : <span />}
    </nav>
  </main>
</Base>

<style>
  .full {
    max-width: 44rem;
    margin: 0 auto;
    padding: clamp(1.5rem, 5vw, 4rem) 1.25rem 5rem;
  }
  .full-back {
    display: inline-block;
    margin-bottom: 3rem;
    color: var(--ink);
    font-weight: 500;
    text-underline-offset: 0.25em;
  }
  .full-period {
    margin: 0 0 0.5rem;
    color: var(--muted);
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .full-org {
    margin: 0.6rem 0 0;
    font-size: 1.15rem;
    color: var(--violet);
    font-weight: 600;
  }
  .full-summary {
    margin: 1.75rem 0 0;
    font-size: 1.2rem;
    line-height: 1.55;
  }
  .full-details {
    margin: 2rem 0 0;
    padding-left: 1.2rem;
    line-height: 1.7;
  }
  .full-details li + li {
    margin-top: 0.5rem;
  }
  .full-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }
  .full-tags li {
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.9rem;
  }
  .full-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-strong);
  }
  .full-nav a {
    color: var(--ink);
    text-underline-offset: 0.25em;
  }
</style>
