---
// import CursorDragon from '@/components/dragon/CursorDragon.astro';
---
<div>
  <svg
    class="cursor-dragon"
    data-cursor-dragon
    aria-hidden="true"
    focusable="false"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="dragon-ice" x1="0" y1="-18" x2="0" y2="18" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#f8fdff" />
        <stop offset=".52" stop-color="#b9eaff" />
        <stop offset="1" stop-color="#63b9ef" />
      </linearGradient>
      <filter id="dragon-mist" x="-120%" y="-120%" width="340%" height="340%" color-interpolation-filters="sRGB">
        <feGaussianBlur in="SourceAlpha" stdDeviation="5" result="wide-blur" />
        <feFlood flood-color="#55baff" flood-opacity=".58" result="mist-color" />
        <feComposite in="mist-color" in2="wide-blur" operator="in" result="mist" />
        <feGaussianBlur in="SourceAlpha" stdDeviation="1.8" result="close-blur" />
        <feFlood flood-color="#e4f8ff" flood-opacity=".8" result="glow-color" />
        <feComposite in="glow-color" in2="close-blur" operator="in" result="glow" />
        <feMerge>
          <feMergeNode in="mist" />
          <feMergeNode in="glow" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
      <g id="dragon-head">
        <path
          fill="url(#dragon-ice)"
          d="M-19-5.5c4.2-7.1 12.1-9.2 19-5.9 3.6 1.4 5.6 3.9 8.5 5.2l12.8 2.8-7.1 3.1 5.6 2.2-10.2 3.5C4.8 8.8 1.4 9.7-3 8.2c-5.1 3.5-11.4 2.9-16.2-.4l-5.7.7 3.7-4.1-4-2.6 5-1.6z"
        />
        <path fill="#dff6ff" d="M-12-10c-1.8-5.1-5.1-7.1-9.5-7.4 1.2 4.5 3.6 7.5 7.6 9.5M-3-12c-.1-4.2 1.9-7.2 5.3-9.2l1.5 9.5" />
        <path fill="#397fae" d="M7.3-4.2a1.15 1.15 0 1 0 0 2.3 1.15 1.15 0 0 0 0-2.3" />
        <path fill="#eaf9ff" d="M-22.3-2.6l-4.1-2.7 1.5 4.3-1.5 3.3 4.1-1.6z" />
      </g>
      <g id="dragon-scale">
        <path
          fill="url(#dragon-ice)"
          d="M12 0C7.2-4.1.1-4.7-6.1-2.8L-12 0l5.9 2.8C.1 4.7 7.2 4.1 12 0Z"
        />
        <path d="M5-2.4 1.4 0 5 2.4" fill="none" stroke="#f4fcff" stroke-opacity=".8" stroke-width="1" />
      </g>
      <g id="dragon-fin">
        <path
          fill="url(#dragon-ice)"
          d="M10 0C3.2-1.6-.6-5.7-3.5-12.5c-.6 5.5.2 8.9 3.6 11.7C-5-1.2-9.1-3.1-13-7.2-11.3-2.5-8.6.1-4.1 1.2-7.2 2.1-9.8 4.1-12 7c5.5-2.3 9.1-3.7 13-4.1C4.3 2.4 7.3 1.4 10 0Z"
        />
      </g>
    </defs>
    <g data-dragon-trail filter="url(#dragon-mist)"></g>
  </svg>
</div>

<script>
  const SVG_NS = 'http://www.w3.org/2000/svg';
  const SEGMENT_COUNT = 13;
  const SEGMENT_SPACING = 6.2;
  const HEAD_SCALE = 0.46;

  interface TrailNode {
    x: number;
    y: number;
    use: SVGUseElement;
  }

  document.querySelectorAll<SVGSVGElement>('[data-cursor-dragon]').forEach((svg) => {
    const trail = svg.querySelector<SVGGElement>('[data-dragon-trail]');
    if (!trail || window.matchMedia('(prefers-reduced-motion: reduce), (pointer: coarse)').matches) return;

    let pointerX = window.innerWidth / 2;
    let pointerY = window.innerHeight / 2;
    let lastPointerMove = performance.now();
    let heading = 0;
    let previousTime = lastPointerMove;
    let animationFrame = 0;
    const nodes: TrailNode[] = [];

    for (let i = 0; i < SEGMENT_COUNT; i += 1) {
      const use = document.createElementNS(SVG_NS, 'use');
      const shape = i === 0 ? 'dragon-head' : i === 4 || i === 8 ? 'dragon-fin' : 'dragon-scale';
      use.setAttribute('href', `#${shape}`);
      use.style.opacity = String(Math.max(0.16, 0.84 - i * 0.052));
      nodes.push({
        x: pointerX - i * SEGMENT_SPACING,
        y: pointerY,
        use,
      });
    }

    for (const node of [...nodes].reverse()) trail.appendChild(node.use);

    const onPointerMove = (event: PointerEvent) => {
      pointerX = event.clientX;
      pointerY = event.clientY;
      lastPointerMove = performance.now();
    };
    window.addEventListener('pointermove', onPointerMove, { passive: true });

    const animate = (time: number) => {
      const delta = Math.min((time - previousTime) / 1000, 0.05);
      previousTime = time;

      const idle = Math.min(7, Math.max(0, (time - lastPointerMove - 450) / 90));
      const targetX = pointerX + Math.cos(time * 0.0015) * idle;
      const targetY = pointerY + Math.sin(time * 0.0019) * idle;
      const head = nodes[0]!;
      const oldX = head.x;
      const oldY = head.y;
      const headFollow = 1 - Math.exp(-delta * 11);
      head.x += (targetX - head.x) * headFollow;
      head.y += (targetY - head.y) * headFollow;

      const dx = head.x - oldX;
      const dy = head.y - oldY;
      if (Math.hypot(dx, dy) > 0.08) {
        const desiredHeading = Math.atan2(dy, dx);
        const difference = Math.atan2(Math.sin(desiredHeading - heading), Math.cos(desiredHeading - heading));
        heading += difference * (1 - Math.exp(-delta * 9));
      }
      head.use.setAttribute('transform', `translate(${head.x} ${head.y}) rotate(${heading * 180 / Math.PI}) scale(${HEAD_SCALE})`);

      for (let i = 1; i < nodes.length; i += 1) {
        const node = nodes[i]!;
        const previous = nodes[i - 1]!;
        const offsetX = previous.x - node.x;
        const offsetY = previous.y - node.y;
        const distance = Math.hypot(offsetX, offsetY) || 1;
        const follow = 1 - Math.exp(-delta * 20);
        node.x += (previous.x - offsetX / distance * SEGMENT_SPACING - node.x) * follow;
        node.y += (previous.y - offsetY / distance * SEGMENT_SPACING - node.y) * follow;
        const angle = Math.atan2(previous.y - node.y, previous.x - node.x) * 180 / Math.PI;
        const scale = Math.max(0.28, HEAD_SCALE - i * 0.012);
        node.use.setAttribute(
          'transform',
          `translate(${(previous.x + node.x) / 2} ${(previous.y + node.y) / 2}) rotate(${angle}) scale(${scale})`,
        );
      }

      animationFrame = window.requestAnimationFrame(animate);
    };

    animationFrame = window.requestAnimationFrame(animate);
    window.addEventListener('pagehide', () => {
      window.cancelAnimationFrame(animationFrame);
      window.removeEventListener('pointermove', onPointerMove);
    }, { once: true });
  });
</script>

<style>
  .cursor-dragon {
    position: fixed;
    inset: 0;
    z-index: 20;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
</style>
